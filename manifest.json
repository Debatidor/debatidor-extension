{
  "manifest_version": 3,
  "name": "Debatidor",
  "version": "0.5.0",
  "description": "Connects an open chat tab to a Debatidor room. Observes generation in the page and relays files the assistant publishes to your Debatidor agent. Does not access the disk.",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Debatidor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": ["asset-transport.js", "hosts/qwen.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["asset-transport.js", "hosts/chatgpt.js", "hosts/chatgpt-stability.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://z.ai/*", "https://*.z.ai/*"],
      "js": ["asset-transport.js", "hosts/zai.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["asset-transport.js", "hosts/claude.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
